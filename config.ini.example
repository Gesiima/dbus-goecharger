; See config.ini.defaults for every option with its code-level default, and
; the "Configuration reference" section in README.md on GitHub for full
; explanations of what each one does:
; https://github.com/Gesiima/dbus-goecharger#configuration-reference
;
; These are the values from a real, working installation (single-phase
; Multiplus-II GX on a three-phase grid connection, AC- and DC-coupled PV,
; go-e V4).

[DEFAULT]
AccessType = OnPremise
SignOfLifeLog = 1
Deviceinstance = 43
HardwareVersion = 4
AcPosition = 1
Logging = WARN
EnableChargeControl = true
BatteryPriorityMinSoc = 60
BatteryPriorityHysteresis = 2
BatterySupportMinSoc = 0
BatterySupportPower = 2500
BatterySupportHysteresis = 2
BatterySupportCompensatePgt = 1
BatterySupportMinPv = 200
BatteryForceStartSoc = 0
PvAverageResetCycles = 1
AutoStartMode = 3
PreventBatteryDischarge = 1
CheckEssMinSocAtStartup = 1
ExpectedEssMinSoc = 20
GridCurrentLimitMode = 0
GridCurrentLimit = 35
GridCurrentSafetyMargin = 3
GridCurrentReleaseMargin = 2
GridCurrentMinAmp = 6
GridCurrentSustainedCycles = 3
GridCurrentReleaseCycles = 3

[ONPREMISE]
Host = 192.168.2.36
PauseBetweenRequests = 5000
