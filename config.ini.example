[DEFAULT]
; --- Existing options (unchanged from the original) ---
AccessType = OnPremise
SignOfLifeLog = 1
Deviceinstance = 43
; go-e hardware generation. Only affects the temperature reading (MCU/Temperature) -
; energy calculation (eto) is handled uniformly via the API v2 unit (Wh) in this
; fork, since the /api/status endpoint always returns API v2 data.
HardwareVersion = 4
; 0 = AC Output (critical loads), 1 = AC Input
AcPosition = 1
Logging = INFO

; =========================================================================
; --- Extended charge control (optional) ---
; =========================================================================
; Master switch. When 'false' (or the line is missing), this script behaves
; exactly like the original: monitoring only, /Mode is not writable, no writes
; to lmo/fup/pgt/scheduler, no PV surplus push. All options below have no
; effect in that case.
EnableChargeControl = true

; --- Grid target (Auto mode only) ---
; Sent to the go-e as 'pgt' when Auto mode is activated.
; Target power at the grid connection point, in W. Positive values = slight
; grid import, negative values = slight feed-in.
; If you have a home battery that the go-e cannot see directly, go-e itself
; recommends -200 W, together with "prefer feeding to the grid" in the go-e app
; (App: PV surplus -> Grid target / Power preference).
PvGridTarget = -200

; --- Battery priority (Auto mode only) ---
; The EV only starts charging once the home battery has reached this SOC.
; 0 or omit the line = feature disabled.
BatteryPriorityMinSoc = 60
; Hysteresis in percentage points: charging pauses below BatteryPriorityMinSoc
; and is only released again once SOC reaches BatteryPriorityMinSoc + hysteresis.
; Prevents flapping right at the threshold.
BatteryPriorityHysteresis = 2

; --- Battery as a charging buffer (Auto mode only) ---
; Above this SOC, additional energy from the home battery is allowed to flow
; into the EV (virtual surplus added to pPv).
; 0 or omit the line = feature disabled.
BatterySupportMinSoc = 90
; Additional power in W reported to the go-e as virtual PV surplus.
; Should not exceed the system's actual discharge limit, otherwise the
; difference will be drawn from the grid instead.
BatterySupportPower = 2500
; Hysteresis in percentage points: the buffer stays active down to
; BatterySupportMinSoc - hysteresis.
BatterySupportHysteresis = 2

; --- /AutoStart toggle function (always active, independent of EnableChargeControl) ---
; The Venus OS "Autostart" button (otherwise permanently non-functional for
; this device, see README) is repurposed as a manual phase-switching (psm)
; override. This defines what the two toggle positions actually do.
; IMPORTANT: read once at script startup only - a config.ini edit here needs
; a service restart to take effect, unlike most other settings above.
; 0 = disabled, the button has no function at all (psm is never touched)
; 1 = "1P-Auto":  Off -> force 1-phase (psm=1), On -> Auto (psm=0)          [default]
; 2 = "3P-Auto":  Off -> force 3-phase (psm=2), On -> Auto (psm=0)
; 3 = "1P-3P":    Off -> force 1-phase (psm=1), On -> force 3-phase (psm=2) [Auto/psm=0 never used]
AutoStartMode = 1

[ONPREMISE]
Host = 192.168.2.36
; Poll interval in ms. Must be at most 5000 for the PV surplus push in Auto
; mode, since the go-e expects pGrid/pPv/pAkku to be updated every 5 seconds,
; otherwise the go-e's internal watchdog (~6s) kicks in and the values expire.
PauseBetweenRequests = 5000
